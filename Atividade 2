#include <stdio.h>

int main() {
    int opcao;
    float total = 0;

    do {
        printf("--- Cofrinho Digital ---\n");
        printf("1 - Adicionar R$0,50\n");
        printf("2 - Adicionar R$1,00\n");
        printf("3 - Adicionar R$2,00\n");
        printf("0 - Encerrar e ver o total\n");
        printf("Escolha uma opcao: ");
        scanf("%d", &opcao);

        if (opcao == 1) {
            total += 0.50;
            printf("Adicionado: R$0,50 (total parcial: R$%.2f)\n\n", total);
        } else if (opcao == 2) {
            total += 1.00;
            printf("Adicionado: R$1,00 (total parcial: R$%.2f)\n\n", total);
        } else if (opcao == 3) {
            total += 2.00;
            printf("Adicionado: R$2,00 (total parcial: R$%.2f)\n\n", total);
        } else if (opcao == 0) {
            printf("Encerrando o cofrinho...\n\n");
        } else {
            printf("Opcao invalida. Digite 0, 1, 2 ou 3.\n\n");
        }

    } while (opcao != 0);

    printf("--- Resultado final ---\n");
    printf("Total acumulado no cofrinho: R$%.2f\n", total);

    return 0;
}
