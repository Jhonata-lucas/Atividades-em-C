#include <stdio.h>

int main() {
    float consumo, somaConsumo = 0, mediaGeral;
    int i;

    for (i = 1; i <= 5; i++) {
        printf("Digite o consumo (m3) do morador %d: ", i);
        scanf("%f", &consumo);

        if (consumo <= 20) {
            printf("Consumo dentro da media.\n\n");
        } else {
            printf("Consumo ACIMA da media.\n\n");
        }

        somaConsumo += consumo;
    }

    mediaGeral = somaConsumo / 5;

    printf("--- Resultado final ---\n");
    printf("Consumo medio geral do condominio: %.2f m3\n", mediaGeral);

    return 0;
}
